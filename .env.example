# Local SQLite database (path is relative to the prisma/ folder).
# For Vercel + hosted Postgres, switch the datasource provider in
# prisma/schema.prisma to "postgresql" and set this to the pooled connection string.
DATABASE_URL="file:./dev.db"

# Signs nothing user-visible today; required in production so deploys fail closed
# if the environment was not configured. Use a long random string.
AUTH_SECRET="replace-with-a-long-random-string"

# Sample users are created by `npm run db:seed`. This is a fake demo password.
# Change it before any real deployment and do not reuse it anywhere else.
SEED_PASSWORD="demo-pass-7783"

# Builder Prime Open API. Leave the key empty to use mock / sample-data mode.
# Generate a key in Builder Prime: Admin > Integrations > Open API.
# Required scope for sync: projects.read. The key is read only on the server.
BUILDER_PRIME_API_KEY=""
BUILDER_PRIME_SUBDOMAIN="endlesspoxybilities"

# Shared secret Builder Prime (or Zapier) must send as the x-webhook-secret header.
# The webhook stays disabled until this is set.
BUILDER_PRIME_WEBHOOK_SECRET=""

# Protects GET/POST /api/cron/builder-prime (nightly sync). Send header x-cron-secret.
CRON_SECRET=""
