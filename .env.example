# Local Postgres from docker compose. The password below is only for your own computer.
DATABASE_URL="postgresql://workbook:workbook@127.0.0.1:5432/workbook"
DIRECT_URL="postgresql://workbook:workbook@127.0.0.1:5432/workbook"

# Local value can be anything long. On Vercel, generate a new one and do not reuse this file.
AUTH_SECRET="replace-with-a-long-random-string"

# Local sample users only. Production ignores this unless SEED_SAMPLE_DATA=true.
SEED_PASSWORD="demo-pass-7783"
# SEED_SAMPLE_DATA="false"

# Leave empty until Builder Prime gives you a key. Sync stays on sample projects until then.
BUILDER_PRIME_API_KEY=""
BUILDER_PRIME_SUBDOMAIN="endlesspoxybilities"
BUILDER_PRIME_WEBHOOK_SECRET=""

# Nightly sync. Vercel sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""

# Used only by the live /setup page. Not required for local sample data.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""
# SETUP_SECRET=""
